<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_service_card"
    android:padding="8dp">

    <ImageView
        android:id="@+id/ivServiceImage"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:background="#E0E0E0"
        android:contentDescription="Service Image" />

    <TextView
        android:id="@+id/tvServiceName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Service Name"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/tvServicePrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="From ₱0.00"
        android:textSize="12sp"
        android:textColor="@color/color_primary" />

    <TextView
        android:id="@+id/btnRemoveService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:padding="6dp"
        android:text="Remove"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#B91C1C"
        android:background="@drawable/button_outline_light" />

</LinearLayout>
