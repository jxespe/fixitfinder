<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FixIt Finder App"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@color/color_primary"
        android:padding="16dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="@dimen/back_btn_width"
        android:layout_height="@dimen/back_btn_height"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        android:contentDescription="Back"
        android:src="@drawable/ic_back_chevron"
        android:tint="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardOtp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@+id/tvAppTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTwoStepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Two-Step Verification"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:gravity="center"
                android:background="@color/color_primary"
                android:padding="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/ivOtpIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    android:tint="@color/color_primary"
                    android:contentDescription="OTP" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOtpInstructions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Please enter your OTP (one time password) to verify your account."
                        android:textSize="14sp"
                        android:textColor="@color/color_text_dark" />

                    <TextView
                        android:id="@+id/tvOtpSentTo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="A code has been sent to"
                        android:textSize="13sp"
                        android:textColor="@color/text_gray" />

                    <TextView
                        android:id="@+id/tvMaskedPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+**********26"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/color_text_dark" />

                    <EditText
                        android:id="@+id/edtOtp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Enter your code"
                        android:inputType="number"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:background="@drawable/edittext_background" />

                    <Button
                        android:id="@+id/btnVerifyOtp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Verify"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/color_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end">

                        <TextView
                            android:id="@+id/tvResendLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="not received your code? "
                            android:textSize="12sp"
                            android:textColor="@color/text_gray" />

                        <TextView
                            android:id="@+id/tvResend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resend code"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/color_primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOtpStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Code expires in 01:00"
                        android:textSize="12sp"
                        android:textColor="@color/text_gray" />

                    <CheckBox
                        android:id="@+id/cbSaveDevice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="save device"
                        android:textSize="12sp"
                        android:textColor="@color/color_text_dark" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

