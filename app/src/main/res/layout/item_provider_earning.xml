<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_service_card"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/tvBookingNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="020120261"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/tvPaidBy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paid by: user@email.com"
        android:textSize="12sp"
        android:textColor="#757575"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvPaidAt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payment date: Feb 1, 2026 4:00 PM"
        android:textSize="12sp"
        android:textColor="#757575"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvJobDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Job: Aircon Cleaning"
        android:textSize="12sp"
        android:textColor="#757575"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvPaymentMethod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payment Method: Cash"
        android:textSize="12sp"
        android:textColor="#757575"
        android:layout_marginTop="2dp" />
</LinearLayout>
