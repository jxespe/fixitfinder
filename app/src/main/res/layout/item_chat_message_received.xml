<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="bottom|start"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Fixed slot so clustered bubbles line up like Messenger -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp">

        <ImageView
            android:id="@+id/ivMessageAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|start"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_profile_circle"
            android:contentDescription="Sender photo" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start">

        <TextView
            android:id="@+id/tvMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_box_outline_black"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:padding="10dp"
            android:maxWidth="260dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivMessageImage"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="6dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:background="#E5E7EB"
            android:visibility="gone"
            android:contentDescription="Message image" />
    </LinearLayout>
</LinearLayout>
